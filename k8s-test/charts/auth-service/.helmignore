# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/


# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
.venv/
venv/
env/

# Build artifacts
build/
dist/

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore
